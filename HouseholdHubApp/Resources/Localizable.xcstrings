    "Amounts like 1.234 can be read more than one way: choose the decimal mark.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Montos como 1.234 se pueden leer de más de una forma: elige el separador decimal."

    },
    "Amounts you've recorded, and your accounts' balances, are stored in this currency, so it can't change without reinterpreting them. To use another currency, start a new data set (back up first).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los montos que registraste y los saldos de tus cuentas se guardan en esta moneda, así que no puede cambiar sin reinterpretarlos. Para usar otra moneda, empieza un nuevo conjunto de datos (haz un respaldo primero)."
          }
        }
      }
    },

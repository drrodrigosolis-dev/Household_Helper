    "%@ can't be used for this type. Choose another category.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se puede usar para este tipo. Elige otra categoría."
          }
        }
      }
    },
    "%@ is due tomorrow.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vence mañana."
          }
        }
      }
    },
